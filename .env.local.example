# Šablona env souboru pro lokální vývoj.
# Zkopíruj na .env.local a doplň skutečné hodnoty.
# Soubor .env.local je v .gitignore — NIKDY ho necommituj.

# --- SuperSaaS (rezervační systém) ---
SUPERSAAS_USER=
SUPERSAAS_API_KEY=

# --- Backend kartotéky (Václavův Java backend) ---
# URL je proxována přes Next rewrites v next.config.ts.
# Pro vývoj na test serveru typicky http://localhost:8080.
# Frontend volá relativní /CardFileWebWS/rest/* → Next ji forwarduje sem.
NEXT_PUBLIC_API_BACKEND_URL=http://localhost:8080
