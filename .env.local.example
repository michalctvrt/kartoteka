# Šablona env souboru pro lokální vývoj.
# Zkopíruj na .env.local a doplň skutečné hodnoty.
# .env.local je v .gitignore — NIKDY ho necommituj.

# --- SuperSaaS (rezervační systém) ---
SUPERSAAS_USER=
SUPERSAAS_API_KEY=

# --- Backend kartotéky (Václavův Java backend) ---
#
# Frontend volá relativní /api/cardfile/rest/* → Next.js proxy
# v app/api/cardfile/[...path]/route.ts forwarduje na BACKEND_BASE_URL.
# Backend běží v Payaře — pro test server typicky http://localhost:8080.
BACKEND_BASE_URL=http://localhost:8080

# --- DEV-ONLY: cookie z přihlášené staré kartotéky (pro auth na backend) ---
#
# Bez ní backend vrací FORM-login HTML. Postup:
#   1) Přihlas se v prohlížeči do http://cftest.dc-flipper.cz/CFLocalSyncWeb/
#   2) F12 → Application → Cookies → cftest.dc-flipper.cz
#   3) Zkopíruj hodnoty JSESSIONIDSSO a JSESSIONID a slož do následujícího formátu:
#
# BACKEND_DEV_COOKIE=JSESSIONIDSSO=...; JSESSIONID=...
#
# 🔐 V produkci se nepoužije — UI poběží same-origin pod /CardFileWebWS/michalovo/
# a auth bude přes sdílenou session prohlížeče (žádná cookie v env).
BACKEND_DEV_COOKIE=
