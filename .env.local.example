# Šablona env souboru pro lokální vývoj.
# Zkopíruj na .env.local a doplň skutečné hodnoty.
# .env.local je v .gitignore — NIKDY ho necommituj.

# --- SuperSaaS (rezervační systém) ---
SUPERSAAS_USER=
SUPERSAAS_API_KEY=

# --- Backend kartotéky (Václavův Java backend) ---
#
# Frontend volá relativní /api/cardfile/rest/* → Next.js proxy
# v app/api/cardfile/[...path]/route.ts forwarduje na BACKEND_BASE_URL.
# Backend běží v Payaře — pro test server typicky http://localhost:8080.
BACKEND_BASE_URL=http://localhost:8080

# --- DEV-ONLY: cookie z přihlášené staré kartotéky (pro auth na backend) ---
#
# Bez ní backend vrací FORM-login HTML. Postup:
#   1) Přihlas se v prohlížeči do http://cftest.dc-flipper.cz/CFLocalSyncWeb/
#   2) F12 → Application → Cookies → cftest.dc-flipper.cz
#   3) Zkopíruj hodnoty JSESSIONIDSSO a JSESSIONID a slož do následujícího formátu:
#
# BACKEND_DEV_COOKIE=JSESSIONIDSSO=...; JSESSIONID=...
#
# 🔐 V produkci se nepoužije — UI poběží same-origin pod /CardFileWebWS/michalovo/
# a auth bude přes sdílenou session prohlížeče (žádná cookie v env).
BACKEND_DEV_COOKIE=

# --- Vyvolávací systém Call250V (Kadlec elektronika) — pobočka Olomoucká ---
#
# Volá se jen ze serveru (app/api/queue/*). Api-Key = číslo licence Call250V.
# Když CALL250V_BASE_URL chybí, běží vestavěný SIMULÁTOR (lib/call250v/mock.ts)
# a na recepci se objeví tlačítka „Vytisknout lístek“ místo kiosku.
CALL250V_BASE_URL=
CALL250V_API_KEY=
# Použije se, když pracoviště nemá vyplněné vlastní ID operátora
CALL250V_DEFAULT_OPERATOR_ID=
# CALL250V_MOCK=1

# --- Stará (JSF) kartotéka – kam vede „Nové vyšetření“ a „Vyšetření pacienta“ ---
# Ve vývoji výchozí http://localhost:8080. V produkci (stejná doména) nechat prázdné.
# NEXT_PUBLIC_LEGACY_BASE_URL=http://localhost:8080

# --- Pracoviště (kód ordinace v kartotéce) pro zakládání vyšetření ---
# Povinné pro POST /study. Např. BRLE = Lesná. Když chybí, formulář ukáže výběr.
# NEXT_PUBLIC_WORKINGPLACE=BRLE

# Zakládat vyšetření přes nový formulář (POST /study) místo staré kartotéky.
# Zapnout až backend přestane vyžadovat ezadankaId u vyšetření bez e-žádanky.
# NEXT_PUBLIC_STUDY_VIA_API=1

# Upravovat studii přes nový formulář (PUT /study/{id}) místo staré kartotéky.
# Zapnout až backend přestane vracet 422 „Error deserializing object“ (i na {}).
# NEXT_PUBLIC_STUDY_EDIT_VIA_API=1

# Demo režim (doma / bez firemní sítě): backend ani SuperSaaS se nevolají, odpovídají
# smyšlená data z lib/demo/. Návod: docs/DOMA.md
# DEMO_MODE=1

# Provozní aplikace /opt/testapp (hromadný tisk, lékaři, spotřební materiál…) – její backend.
# TESTAPP_API_URL=http://<server>:<port>/api

# Ověření pojištění (registr pojištěnců) – stejná služba jako testapp
# VZP_API_URL=https://<sluzba>/api/vzp
# VZP_CONNECT_HOST=127.0.0.1        # když služba běží na tomto serveru a veřejné jméno zevnitř nejde

# Spotřební materiál: zápis do ostrých objednávek z Kartotéky (VÝCHOZÍ VYPNUTO – zapínat jen po domluvě)
# SPOTREBA_WRITE=1
